---
import Lab from "../components/lab/Lab.svelte";
import LabMenu from "../components/LabMenu.astro";
import MeldFout from "../components/MeldFout.astro";
import Base from "../layouts/Base.astro";
import { kalibratie, labKnoppen, pad, params, presets, voorbeelden } from "../lib/data.ts";
---

<Base
  title="Scenariolab: speel minister van Financiën — Box1lab"
  description="Verander zelf de belastingen en toeslagen en zie wat het kost, wie erop vooruitgaat en wat het met jou doet."
  breed
>
  <LabMenu />
  <h1>Speel minister van Financiën</h1>
  <p class="intro">
    Verander de belasting en de toeslagen en zie wat er gebeurt: voor de schatkist, per inkomensgroep, voor
    armoede en voor huishoudens zoals het jouwe.
  </p>
  <Lab
    client:load
    {params}
    {kalibratie}
    populatieUrl={pad("data/populatie-2026.json")}
    {presets}
    knoppen={labKnoppen}
    {voorbeelden}
  />
  <MeldFout />
</Base>

<style>
  h1 {
    margin: 0 0 6px;
  }
  .intro {
    color: var(--muted);
    margin: 0 0 20px;
    max-width: 70ch;
  }
</style>
