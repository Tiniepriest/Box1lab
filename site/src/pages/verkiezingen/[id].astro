---
import Deel from "../../components/Deel.astro";
import Situatie from "../../components/Situatie.svelte";
import Verkiezingen from "../../components/verkiezingen/Verkiezingen.svelte";
import Base from "../../layouts/Base.astro";
import { JAAR, pad, params as nu } from "../../lib/data.ts";
import { nogNietOfficieel } from "../../lib/secties.ts";
import { PREVIEW, verkiezingData, verkiezingIds, type VerkiezingData } from "../../lib/verkiezingen.ts";

export function getStaticPaths() {
  return verkiezingIds.map((id) => ({ params: { id }, props: { data: verkiezingData(id) } }));
}

const { data } = Astro.props as { data: VerkiezingData };
const { verkiezing, params, partijen, macro } = data;
const akkoord = verkiezing.soort === "akkoord";
// Basispad in volgend jaar: eerst wat dat met jou doet ten opzichte van nu (D-064).
const vooraf = verkiezing.basispad.jaar > JAAR ? { huidig: nu, ...nogNietOfficieel(params) } : null;
// Titel en omschrijving zoals mensen zoeken: "wat betekent het voor mij?" (punt 7 van 2 november 2026).
const titel = akkoord
  ? `${verkiezing.menu ?? verkiezing.naam}: wat betekent het voor jou?`
  : `${verkiezing.naam}: wat betekenen de plannen voor jou?`;
const omschrijving = verkiezing.aangenomen
  ? `Wat betekent ${verkiezing.menu ?? verkiezing.naam} voor jouw netto inkomen? Reken het uit voor je eigen situatie, en zie waar het verschil vandaan komt.`
  : akkoord
    ? `Wat betekent ${verkiezing.menu ?? verkiezing.naam} voor jouw netto inkomen? Reken het uit voor je eigen situatie, en zie wat de routes naar een meerderheid daaraan veranderen (${partijen.map((p) => p.naam.replace(/^Route /, "")).join("; ")}).`
    : `Wat betekenen de plannen van de partijen voor jouw netto inkomen? Reken het uit voor je eigen situatie.`;
const datum = new Date(verkiezing.datum).toLocaleDateString("nl-NL", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<Base
  title={`${titel} — Box1lab`}
  description={omschrijving}
  afbeelding={verkiezing.fictief ? undefined : pad(`og/verkiezing-${verkiezing.id}.png`)}
  breed
  nietIndexeren={verkiezing.fictief}
>
  <h1>{titel}</h1>
  <p class="intro">
    {verkiezing.aangenomen
      ? `Aangenomen in de Tweede Kamer op ${datum}. Wat het plan voor jou betekent, en waar het verschil vandaan komt.`
      : akkoord
        ? `Stemming in de Tweede Kamer gepland op ${datum}. ${vooraf ? "Eerst: wat het plan van het kabinet voor jou betekent. Dan: wat de routes daaraan veranderen, voor jouw huishouden en voor Nederland." : "Per route: wat de doorrekenbare plannen doen voor jouw huishouden en voor Nederland."}`
        : `Verkiezing van ${datum}. Per partij: wat de doorrekenbare plannen doen voor jouw huishouden en voor Nederland.`}
  </p>
  {!verkiezing.fictief && <Deel titel={titel} />}
  <div class="met-situatie">
    <Situatie client:load params={nu} plakken />
    <Verkiezingen client:load {params} {verkiezing} {partijen} {macro} {vooraf} preview={PREVIEW} />
  </div>
</Base>

<style>
  h1 {
    margin: 0 0 6px;
  }
  .intro {
    color: var(--muted);
    margin: 0 0 18px;
    max-width: 70ch;
  }
</style>
