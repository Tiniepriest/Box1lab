---
import Verkiezingen from "../../components/verkiezingen/Verkiezingen.svelte";
import Base from "../../layouts/Base.astro";
import { PREVIEW, verkiezingData, verkiezingIds, type VerkiezingData } from "../../lib/verkiezingen.ts";

export function getStaticPaths() {
  return verkiezingIds.map((id) => ({ params: { id }, props: { data: verkiezingData(id) } }));
}

const { data } = Astro.props as { data: VerkiezingData };
const { verkiezing, params, partijen, macro } = data;
const akkoord = verkiezing.soort === "akkoord";
const datum = new Date(verkiezing.datum).toLocaleDateString("nl-NL", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<Base
  title={`${verkiezing.naam} — Box1lab`}
  description={
    akkoord
      ? "Twee routes voor het Belastingplan 2027 naast elkaar: wat betekenen ze voor jouw portemonnee en voor Nederland?"
      : "Wat betekenen de plannen van partijen voor jouw portemonnee?"
  }
  breed
  nietIndexeren={verkiezing.fictief}
>
  <h1>{akkoord ? verkiezing.naam : `${verkiezing.naam}: wat betekenen de plannen voor jou?`}</h1>
  <p class="intro">
    {akkoord
      ? `Stemming in de Tweede Kamer gepland op ${datum}. Per route: wat de doorrekenbare plannen doen voor jouw huishouden en voor Nederland.`
      : `Verkiezing van ${datum}. Per partij: wat de doorrekenbare plannen doen voor jouw huishouden en voor Nederland.`}
  </p>
  <Verkiezingen client:load {params} {verkiezing} {partijen} {macro} preview={PREVIEW} />
</Base>

<style>
  h1 {
    font-size: clamp(26px, 4vw, 34px);
    margin: 0 0 6px;
  }
  .intro {
    color: var(--muted);
    margin: 0 0 18px;
    max-width: 70ch;
  }
</style>
