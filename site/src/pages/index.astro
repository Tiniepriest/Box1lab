---
import Base from "../layouts/Base.astro";
---

<Base title="Box1lab — wat betekent het belastingstelsel voor jou?">
  <h1>Wat betekent het belastingstelsel voor jou?</h1>
  <p class="lead">
    Deze site is in opbouw. Straks kun je hier zien wat belastingen en toeslagen voor jouw huishouden
    betekenen, zelf de regels veranderen en de plannen van partijen doorrekenen.
  </p>
</Base>

<style>
  h1 {
    font-size: clamp(28px, 5vw, 40px);
    margin: 0 0 12px;
  }
  .lead {
    color: var(--muted);
    max-width: 60ch;
    font-size: 18px;
  }
</style>
