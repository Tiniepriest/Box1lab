---
import Calculator from "../components/Calculator.svelte";
import MeldFout from "../components/MeldFout.astro";
import Base from "../layouts/Base.astro";
import { actueel, pad, params, presets, volgendJaar } from "../lib/data.ts";
import { nogNietOfficieel } from "../lib/secties.ts";
import { plekGrenzen } from "../lib/basis.ts";

const volgend = volgendJaar ? { params: volgendJaar, ...nogNietOfficieel(volgendJaar) } : null;
const tabblad = actueel
  ? {
      href: pad(`verkiezingen/${actueel.id}`),
      naam: actueel.menu ?? actueel.naam,
      soort: actueel.soort,
      jaar: actueel.basispad.jaar,
    }
  : null;
---

<Base
  title="Netto inkomen, belasting en toeslagen berekenen — Box1lab"
  description={`Bereken wat je overhoudt na belasting, premies en toeslagen in ${params.jaar}${volgend ? `, en wat er in ${volgend.params.jaar} verandert` : ""}. Gratis en zonder account: wat je invult, blijft in je browser.`}
  breed
>
  <h1>Wat betekent het belastingstelsel voor jou?</h1>
  <p class="intro">
    Vul je situatie in en zie hoeveel belasting je betaalt, welke toeslagen je krijgt en wat je overhoudt.
  </p>
  <Calculator client:load {params} {plekGrenzen} {presets} {volgend} actueel={tabblad} />
  <MeldFout />
</Base>

<style>
  h1 {
    margin: 0 0 6px;
  }
  .intro {
    color: var(--muted);
    margin: 0 0 20px;
    max-width: 65ch;
  }
</style>
