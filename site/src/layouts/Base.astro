---
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/source-serif-4/400.css";
import "@fontsource/source-serif-4/600.css";
import "@fontsource/source-serif-4/600-italic.css";
import "../styles/global.css";
import { MODEL_VERSIE, actueel, changelog, params, pad } from "../lib/data.ts";
import { SLEUTEL } from "../lib/opslag.ts";
import { REPO, meldFoutUrl } from "../lib/project.ts";

interface Props {
  title: string;
  description?: string;
  /** Breed: voor het lab en de calculator. */
  breed?: boolean;
  /** Deelafbeelding (pad binnen de site); standaard de algemene. */
  afbeelding?: string;
  /** Niet in zoekmachines (bijvoorbeeld voor een voorbeeld met fictieve partijen). */
  nietIndexeren?: boolean;
}

const {
  title,
  description = "Wat betekent het belasting- en toeslagenstelsel voor jou? Reken je eigen situatie door en speel minister van Financiën.",
  breed = false,
  afbeelding = pad("og/standaard.png"),
  nietIndexeren = false,
} = Astro.props;
const afbeeldingUrl = new URL(afbeelding, Astro.site).href;
const paginaUrl = new URL(Astro.url.pathname, Astro.site).href;
// "Bijgewerkt" is de nieuwste regel uit de changelog, niet de builddatum: die verandert ook bij een tikfout.
const bijgewerkt = new Date(changelog[0]!.datum).toLocaleDateString("nl-NL", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
const versie = `parameterjaar ${params.jaar}, model ${MODEL_VERSIE}`;
const huidig = Astro.url.pathname.replace(/\/$/, "");
// Hoofdmenu: de tabbladen waar je rekent, vergelijkt en uitprobeert, allemaal met jouw situatie (D-064).
// "page" als je op de pagina zelf bent, "true" op een pagina die bij het tabblad hoort (zoals een voorstel).
const actief = (href: string, ookOnder: string[] = []): "page" | "true" | undefined =>
  huidig === href ? "page" : ookOnder.some((o) => huidig.startsWith(o)) ? "true" : undefined;
const tabbladen = [
  { href: pad("jouw-situatie"), label: "Jouw situatie", situatie: true },
  // De nieuwste echte verkiezing of vergelijking van routes, als die er is.
  ...(actueel ? [{ href: pad(`verkiezingen/${actueel.id}`), label: actueel.menu ?? actueel.naam }] : []),
  { href: pad("lab"), label: "Scenariolab", onder: [pad("voorstellen")] },
];
// Bijmenu: lezen over het stelsel en over Box1lab.
const bijmenu = [
  { href: pad("uitleg"), label: "Uitleg" },
  { href: pad("methodiek"), label: "Methodiek" },
  { href: pad("over"), label: "Over" },
];
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <!-- Wat je invult, blijft in je browser: de pagina mag geen gegevens naar een andere site sturen (review 3.7). -->
    <meta http-equiv="Content-Security-Policy" content="connect-src 'self'" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f2ea" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1814" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={pad("favicon.svg")} />
    <link rel="sitemap" href={pad("sitemap-index.xml")} />
    <title>{title}</title>
    <script is:inline>
      // Licht of donker: koos je zelf, dan geldt die keuze; anders volgt de site je apparaat. Vóór het tekenen,
      // zodat de pagina niet eerst in de andere kleur verschijnt.
      try {
        const thema = localStorage.getItem("box1lab-thema");
        if (thema === "light" || thema === "dark") {
          document.documentElement.dataset.theme = thema;
          const kleur = thema === "dark" ? "#1a1814" : "#f6f2ea";
          for (const m of document.querySelectorAll('meta[name="theme-color"]'))
            m.setAttribute("content", kleur);
        }
      } catch {
        /* geen opslag: de kleur van het apparaat */
      }
    </script>
    <script is:inline define:vars={{ sleutel: SLEUTEL }}>
      // Vinkje bij "Jouw situatie" als er een bewaarde situatie is; vóór het tekenen, zodat het niet verspringt.
      try {
        if (localStorage.getItem(sleutel) || sessionStorage.getItem(sleutel))
          document.documentElement.dataset.situatie = "ja";
      } catch {
        /* geen opslag: geen vinkje */
      }
    </script>
    {nietIndexeren && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={paginaUrl} />
    <meta property="og:image" content={afbeeldingUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="nl_NL" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#inhoud">
      Naar de inhoud
    </a>
    <header class="site-header">
      <div class="wrap kop">
        <a class="logo" href={pad("")}>
          Box1lab
        </a>
        <nav aria-label="Uitleg en over Box1lab" class="bij">
          <ul class="bij-lijst">
            {bijmenu.map((m) => (
              <li>
                <a href={m.href} aria-current={actief(m.href, [`${m.href}/`])}>
                  {m.label}
                </a>
              </li>
            ))}
          </ul>
          <details class="bij-uitklap">
            <summary>
              <span aria-hidden="true">☰</span> Meer
            </summary>
            <ul>
              {bijmenu.map((m) => (
                <li>
                  <a href={m.href} aria-current={actief(m.href, [`${m.href}/`])}>
                    {m.label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </nav>
        <button
          type="button"
          class="thema"
          aria-pressed="false"
          aria-label="Donkere weergave"
          title="Licht of donker"
        >
          <svg class="maan" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
            <path
              d="M16.5 12.6A7 7 0 0 1 7.4 3.5a7 7 0 1 0 9.1 9.1Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linejoin="round"
            />
          </svg>
          <svg class="zon" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
            <circle cx="10" cy="10" r="3.6" fill="none" stroke="currentColor" stroke-width="1.6" />
            <path
              d="M10 1.8v2.2M10 16v2.2M1.8 10H4M16 10h2.2M4.2 4.2l1.6 1.6M14.2 14.2l1.6 1.6M4.2 15.8l1.6-1.6M14.2 5.8l1.6-1.6"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
            />
          </svg>
        </button>
        <script is:inline>
          // Direct na de knop, zodat hij meteen het goede icoon toont. Ingedrukt = donker.
          (() => {
            const knop = document.currentScript.previousElementSibling;
            const html = document.documentElement;
            const systeem = matchMedia("(prefers-color-scheme: dark)");
            const donker = () => (html.dataset.theme ?? (systeem.matches ? "dark" : "light")) === "dark";
            const toon = () => knop.setAttribute("aria-pressed", String(donker()));
            toon();
            systeem.addEventListener("change", toon);
            knop.addEventListener("click", () => {
              const thema = donker() ? "light" : "dark";
              html.dataset.theme = thema;
              const kleur = thema === "dark" ? "#1a1814" : "#f6f2ea";
              for (const m of document.querySelectorAll('meta[name="theme-color"]'))
                m.setAttribute("content", kleur);
              try {
                localStorage.setItem("box1lab-thema", thema);
              } catch {
                /* geen opslag: alleen voor deze pagina */
              }
              toon();
            });
          })();
        </script>
      </div>
      <nav aria-label="Hoofdmenu" class="wrap tabbladen">
        <ul>
          {tabbladen.map((t) => (
            <li>
              <a href={t.href} aria-current={actief(t.href, t.onder)}>
                {t.label}
                {t.situatie && (
                  <span class="vink">
                    <span aria-hidden="true">✓</span>
                    <span class="visueel-verborgen">(ingevuld)</span>
                  </span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="inhoud" class:list={["wrap", { breed }]}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>
          Parameterjaar {params.jaar} · Modelversie {MODEL_VERSIE} · Bijgewerkt {bijgewerkt} ·{" "}
          <a href={pad("wijzigingen")}>Wat is er veranderd?</a>
        </p>
        <p>
          Geen stemadvies en geen officiële berekening. <a href={pad("methodiek")}>Hoe rekenen we?</a> ·{" "}
          <a href={REPO}>Broncode</a> ·{" "}
          <a href={meldFoutUrl(versie)} data-meldfout>
            Meld een fout
          </a>
        </p>
      </div>
    </footer>
    <script>
      import "../lib/meldfout.ts";
    </script>
  </body>
</html>

<style>
  .wrap {
    max-width: 1080px;
    margin: 0 auto;
    padding-inline: 16px;
  }
  .wrap.breed {
    max-width: 1320px;
  }
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 16px;
    top: 8px;
    background: var(--panel);
    padding: 8px 12px;
    z-index: 10;
  }
  .site-header {
    border-bottom: 1px solid var(--line);
    background: var(--bg);
  }
  .kop {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px 20px;
    padding-block: 10px 4px;
    max-width: 1320px;
  }
  .logo {
    margin-right: auto;
    font-family: var(--f-display);
    font-weight: 600;
    font-style: italic;
    font-size: 26px;
    color: var(--fg);
    text-decoration: none;
  }
  .bij ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .bij-lijst {
    display: flex;
    gap: 4px 16px;
  }
  .bij a {
    color: var(--muted);
    text-decoration: none;
    font-size: 14px;
    padding: 6px 0;
    display: inline-block;
  }
  .bij a:hover,
  .bij a[aria-current] {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .bij-uitklap {
    display: none;
    position: relative;
  }
  .thema {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: none;
    color: var(--muted);
    cursor: pointer;
  }
  .thema:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  /* Het icoon toont waar je naartoe gaat: een maan in licht, een zon in donker. */
  .thema .zon,
  .thema[aria-pressed="true"] .maan {
    display: none;
  }
  .thema[aria-pressed="true"] .zon {
    display: block;
  }
  .bij-uitklap summary {
    list-style: none;
    cursor: pointer;
    font-size: 14px;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 4px 10px;
  }
  .bij-uitklap summary::-webkit-details-marker {
    display: none;
  }
  .bij-uitklap ul {
    position: absolute;
    right: 0;
    top: calc(100% + 4px);
    z-index: 20;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 4px 14px;
    min-width: 160px;
    box-shadow: 0 6px 18px rgb(0 0 0 / 12%);
  }
  .bij-uitklap li a {
    display: block;
    padding: 8px 0;
    font-size: 15px;
    color: var(--fg);
  }
  .tabbladen {
    max-width: 1320px;
  }
  .tabbladen ul {
    list-style: none;
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
  }
  .tabbladen a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 100%;
    padding: 10px 16px 8px;
    border-bottom: 3px solid transparent;
    color: var(--fg);
    font-weight: 500;
    font-size: 16px;
    text-decoration: none;
  }
  .tabbladen a:hover {
    color: var(--accent);
    border-bottom-color: var(--line);
  }
  .tabbladen a[aria-current] {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
  .vink {
    display: none;
    font-size: 12px;
    line-height: 1;
    color: var(--panel);
    background: var(--accent);
    border-radius: 999px;
    padding: 3px 5px;
  }
  :global(html[data-situatie="ja"]) .vink {
    display: inline-block;
  }
  @media (max-width: 640px) {
    .bij-lijst {
      display: none;
    }
    .bij-uitklap {
      display: block;
    }
    .tabbladen ul {
      display: grid;
      grid-auto-columns: minmax(0, 1fr);
      grid-auto-flow: column;
      gap: 0;
    }
    .tabbladen a {
      font-size: 14px;
      line-height: 1.25;
      text-align: center;
      padding: 10px 4px 8px;
    }
  }
  main {
    padding-block: 28px 56px;
    min-height: 60vh;
  }
  .site-footer {
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 13px;
  }
  .site-footer p {
    margin: 6px 0;
  }
  .site-footer .wrap {
    padding-block: 18px;
    max-width: 1320px;
  }
</style>
