---
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-serif/600.css";
import "@fontsource/ibm-plex-mono/400.css";
import "../styles/global.css";
import { MODEL_VERSIE, params, pad } from "../lib/data.ts";

interface Props {
  title: string;
  description?: string;
  /** Breed: voor het lab en de calculator. */
  breed?: boolean;
  /** Deelafbeelding (pad binnen de site); standaard de algemene. */
  afbeelding?: string;
  /** Niet in zoekmachines (bijvoorbeeld voor een voorbeeld met fictieve partijen). */
  nietIndexeren?: boolean;
}

const {
  title,
  description = "Wat betekent het belasting- en toeslagenstelsel voor jou? Reken je eigen situatie door en speel minister van Financiën.",
  breed = false,
  afbeelding = pad("og/standaard.png"),
  nietIndexeren = false,
} = Astro.props;
const afbeeldingUrl = new URL(afbeelding, Astro.site).href;
const paginaUrl = new URL(Astro.url.pathname, Astro.site).href;
const buildDatum = new Date().toLocaleDateString("nl-NL", { day: "numeric", month: "long", year: "numeric" });
const huidig = Astro.url.pathname.replace(/\/$/, "");
const menu = [
  { href: pad("jouw-situatie"), label: "Jouw situatie" },
  { href: pad("lab"), label: "Scenariolab" },
  { href: pad("voorstellen"), label: "Voorstellen" },
  { href: pad("uitleg"), label: "Uitleg" },
  { href: pad("methodiek"), label: "Methodiek" },
  { href: pad("over"), label: "Over" },
];
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1f4e8c" />
    <link rel="icon" type="image/svg+xml" href={pad("favicon.svg")} />
    <title>{title}</title>
    {nietIndexeren && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={paginaUrl} />
    <meta property="og:image" content={afbeeldingUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="nl_NL" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#inhoud">
      Naar de inhoud
    </a>
    <header class="site-header">
      <div class="wrap kop">
        <a class="logo" href={pad("")}>
          Box1lab
        </a>
        <nav aria-label="Hoofdmenu">
          <ul>
            {menu.map((m) => (
              <li>
                <a href={m.href} aria-current={huidig === m.href ? "page" : undefined}>
                  {m.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="inhoud" class:list={["wrap", { breed }]}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>
          Parameterjaar {params.jaar} · Modelversie {MODEL_VERSIE} · Bijgewerkt {buildDatum}
        </p>
        <p>
          Geen stemadvies en geen officiële berekening. <a href={pad("methodiek")}>Hoe rekenen we?</a> ·
          <a href="https://github.com/Tiniepriest/Box1lab">Broncode</a> ·
          <a href="https://github.com/Tiniepriest/Box1lab/issues">Meld een fout</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .wrap {
    max-width: 1080px;
    margin: 0 auto;
    padding-inline: 16px;
  }
  .wrap.breed {
    max-width: 1320px;
  }
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 16px;
    top: 8px;
    background: var(--panel);
    padding: 8px 12px;
    z-index: 10;
  }
  .site-header {
    border-bottom: 1px solid var(--line);
    background: var(--panel);
  }
  .kop {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 20px;
    padding-block: 12px;
    max-width: 1320px;
  }
  .logo {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: 20px;
    color: var(--fg);
    text-decoration: none;
  }
  nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    margin: 0;
    padding: 0;
  }
  nav a {
    color: var(--fg);
    text-decoration: none;
    font-size: 15px;
    padding: 6px 0;
    display: inline-block;
  }
  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  main {
    padding-block: 28px 56px;
    min-height: 60vh;
  }
  .site-footer {
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 13px;
  }
  .site-footer p {
    margin: 6px 0;
  }
  .site-footer .wrap {
    padding-block: 18px;
    max-width: 1320px;
  }
</style>
